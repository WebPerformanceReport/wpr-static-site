    {%- comment -%} The code box is the copy button. One delegated click listener,
        nothing runs until a click. Clipboard API first, execCommand as a fallback
        for older browsers. The tooltip text lives in data-tip (style.css shows it).
        Cookiebot is told to leave it alone: it sets no cookies and tracks nothing. {%- endcomment %}
    <script data-cookieconsent="ignore">
      document.addEventListener('click', function (e) {
        var btn = e.target.closest && e.target.closest('[data-copy]');
        if (!btn) return;
        var text = btn.getAttribute('data-copy');
        var status = btn.parentNode.querySelector('[role="status"]');
        function show(ok) {
          btn.setAttribute('data-tip', ok ? 'Copied!' : 'Copy failed');
          btn.classList.add('is-copied');
          if (status) status.textContent = ok ? 'Code ' + text + ' copied' : 'Could not copy the code';
          clearTimeout(btn._t);
          btn._t = setTimeout(function () {
            btn.setAttribute('data-tip', 'Copy code');
            btn.classList.remove('is-copied');
            if (status) status.textContent = '';
          }, 2000);
        }
        function legacyCopy() {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          var ok = false;
          try { ok = document.execCommand('copy'); } catch (err) {}
          document.body.removeChild(ta);
          btn.focus();
          show(ok);
        }
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(function () { show(true); }, legacyCopy);
        } else {
          legacyCopy();
        }
      });
    </script>
