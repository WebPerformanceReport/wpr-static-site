<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Cookiebot cookie consent script: Banner script -->
    <script defer id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="7819dc9c-01f3-4d09-a8dc-b26fa39e69c0" data-blockingmode="auto" type="text/javascript"></script>

    <!-- META -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta name="author" content="WebPerformance Report">
    <meta name="description" content="Google Search Console report in your inbox, daily, weekly or monthly. Reports, Decisions, Results...">
    <meta name="robots" content="index, follow">
    <meta property="og:title" content="Google Search Console Report | WebPerformance Report">
    <meta property="og:description" content="Google Search Console report in your inbox, daily, weekly or monthly. Clicks, impressions, click-through rate and position for your top queries, pages, countries and devices, compared with the previous period.">
    <meta property="og:image" content="https://webperformancereport.com/assets/img/webperformance-report-google-search-console.png">
    <meta property="og:image:alt" content="Google Search Console Report | WebPerformance Report">
    <meta property="og:locale" content="en_GB">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://webperformancereport.com/gsc/">

    <!-- TWITTER CARD -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@webperfreport" />
    <meta name="twitter:title" content="Google Search Console Report | WebPerformance Report" />
    <meta name="twitter:description" content="Google Search Console report in your inbox, daily, weekly or monthly. Clicks, impressions, click-through rate and position for your top queries, pages, countries and devices, compared with the previous period." />
    <meta name="twitter:image" content="https://webperformancereport.com/assets/img/webperformance-report-google-search-console.png" />

    <!-- SPEED -->

    <!-- LINK -->
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="icon" href="{{ '/' | url }}favicon.ico">
    <link rel="apple-touch-icon" href="{{ '/' | url }}apple-touch-icon.png">

    <!-- PERFORMANCE -->
    <link rel="preload" as="image" href="/assets/img/gsc/google-search-console-hero-image.png?20260927">

    <style>
    /* inter-regular - latin */
    @font-face {
      font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
      font-family: 'Inter';
      font-style: normal;
      font-weight: 400;
      src: url('{{ "/" | url }}fonts/inter-v12-latin-regular.woff2') format('woff2'), /* Chrome 36+, Opera 23+, Firefox 39+ */
          url('{{ "/" | url }}fonts/inter-v12-latin-regular.woff') format('woff'); /* Chrome 5+, Firefox 3.6+, IE 9+, Safari 5.1+ */
    }

    /* inter-700 - latin */
    @font-face {
      font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
      font-family: 'Inter';
      font-style: normal;
      font-weight: 700;
      src: url('{{ "/" | url }}fonts/inter-v12-latin-700.woff2') format('woff2'), /* Chrome 36+, Opera 23+, Firefox 39+ */
          url('{{ "/" | url }}fonts/inter-v12-latin-700.woff') format('woff'); /* Chrome 5+, Firefox 3.6+, IE 9+, Safari 5.1+ */
    }
    </style>

    <link rel="preload" as="style" href="{{ '/' | url }}style.css?20261003">
    <link rel="stylesheet" href="{{ '/' | url }}style.css?20261003">

    <!-- TITLE -->
    <title>{{ title }}</title>
  </head>
  <body class="{{ pageClass }}">
    {% include "layouts/shared/launch-bar.njk" %}
    <header role="banner" class="ui-section-header">
      <div class="ui-layout-container">
        <div class="ui-section-header__layout ui-layout-flex">
          <!-- LOGO -->
          <a href="{{ '/' | url }}" role="link" class="ui-section-header--logo">
            <img src="{{ '/' | url }}assets/img/webperformance-report-logo.png" width="100" height="100" alt="WebPerformance Report" class="">
          </a>
          <!-- HAMBURGER -->
          <input type="checkbox" id="ui-section-header--menu-id">
          <label for="ui-section-header--menu-id" class="ui-section-header--menu-icon"></label>
          <!-- MENU -->
          <nav role="navigation" class="ui-section-header--nav ui-layout-flex">
            <a href="{{ '/' | url }}gsc/#Subscribe" role="link" aria-label="Subscribe" class="ui-section-header--nav-link ui-section-header--nav-link-subscribe">Subscribe</a>
            <a href="{{ '/' | url }}gsc/#About" role="link" aria-label="About" class="ui-section-header--nav-link">About</a>
            <a href="{{ '/' | url }}gsc/#Catalog" role="link" aria-label="Catalog" class="ui-section-header--nav-link">Catalog</a>
            <a href="{{ '/' | url }}gsc/#Report" role="link" aria-label="Report" class="ui-section-header--nav-link">Report</a>
            <a href="{{ '/' | url }}plans/" role="link" aria-label="Plans" class="ui-section-header--nav-link ui-section-header--nav-link-featured ui-section-header--nav-link-first">Plans</a>
            <a href="{{ '/' | url }}gsc/#Contact" role="link" aria-label="Contact" class="ui-section-header--nav-link">Contact</a>
            <a href="{{ '/' | url }}gsc/#Subscribe" role="link" aria-label="Get the Report" class="ui-section-header--nav-cta">Get the Report</a>
            <a href="https://board.webperformancereport.com/" rel="noopener" target="_blank" role="link" aria-label="Your Board" class="ui-section-header--nav-board"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3h4a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-4"/><path d="M8 14l4-4-4-4"/><path d="M12 10H3"/></svg><span>Your Board</span></a>
            <p class="ui-section-header--nav-note">Available from the Lite plan.</p>
          </nav>
        </div>
      </div>
    </header>
    <main role="main">
      <section class="ui-section-hero ui-section-hero--commercial">
        <div class="ui-layout-container">
          <div class="ui-section-hero__layout ui-layout-grid ui-layout-grid-2">
            <!-- COPYWRITING -->
            <div>
              <p class="ui-section-hero--eyebrow">Reports. Decisions. Results.</p>
              <h1><span style="font-size: 2.4rem; color: #fff;">Google Search Console </span> <span style="font-size: 3.10rem;">Report</span></h1>
              <p class="ui-text-intro ui-section-hero--lead">Search performance report delivered directly to your inbox.</p>
              <p class="ui-text-intro">Know how people find you on Google: which searches bring them to your site, which ones are dropping, and where to focus next to grow your organic traffic.</p>
              <!-- CTA -->
              <div class="ui-component-cta ui-layout-flex">
                <div class="ui-section-hero--actions">
                  <a href="#Subscribe" role="link" aria-label="Get the Report" class="ui-component-button ui-component-button-normal ui-component-button-primary">Get the Report</a>
                  <a href="{{ '/' | url }}plans/" role="link" aria-label="See Plans" class="ui-component-button ui-component-button-normal ui-component-button-ghost">See Plans</a>
                </div>
                <p class="ui-text-note ui-section-hero--trust">
                  <small>Available from the Lite plan. Set up from your Board.</small>
                  <small><strong>Built on top of <a href="https://search.google.com/search-console/about?utm_source=webperfreport&utm_medium=website" rel="noopener" target="_blank">Google Search Console</a></strong></small>
                </p>
              </div>
            </div>
            <!-- IMAGE -->
            <img src="{{ '/' | url }}assets/img/gsc/google-search-console-hero-image.png?20260927" width="512" height="463" fetchpriority="high" alt="Google Search Console report showing clicks, impressions, click-through rate and average position with their change against the previous period, and the top queries" class="ui-image-half-right">
          </div>
        </div>
      </section>
      <section class="ui-section-sponsor-strip">
        <a name="Sponsors"></a>
        <div class="ui-layout-container">
          <div class="ui-section-sponsor-strip__layout">
            <p class="ui-section-sponsor-strip--label">Sponsored <span class="ui-section-sponsor-strip--label-soft">by</span></p>
            <a href="https://www.catchpoint.com/?utm_source=webperfreport&utm_medium=website&utm_campaign=sponsors" rel="noopener" target="_blank"><img src="{{ '/' | url }}assets/img/sponsors/sponsor-logo-catchpoint-webpagetest.png" loading="lazy" alt="Catchpoint WebPageTest" width="200" height="71" class="ui-section-sponsor-strip--logo"></a>
            <span class="ui-section-sponsor-strip--divider" aria-hidden="true"></span>
            <p class="ui-section-sponsor-strip--trust">Trusted by teams at Google, Airbnb, Stripe, IKEA, Nestlé and dozens more global brands.</p>
          </div>
        </div>
      </section>
      <section class="ui-section-title">
        <div class="ui-layout-container">
          <h2>{{ mainTitle }}</h2><a name="Subscribe"></a>
        </div>
      </section>
      <section class="ui-section-subscribe">
        <div class="ui-layout-container">
          {% block pagemaincontent %}
          {% endblock %}
        </div>
      </section>
      {% block shared_content_testimonials %}
      {% endblock %}
      <section class="ui-section-title">
        <div class="ui-layout-container">
          <h2>About Search Report</h2><a name="About"></a>
        </div>
      </section>
      <section class="ui-section-about">
        <div class="ui-layout-container">
          <div class="ui-section-about__cards">
            <!-- THE PRODUCT: the same first paragraph on every report page -->
            <div class="ui-section-about__card ui-section-about__card--product">
              <h3 class="ui-section-about__title">About WebPerformance Report</h3>
              <p>WebPerformance Report is a reporting service. It gathers data from the tools you already trust and turns it into a clear report delivered to your inbox, on your schedule. Free to start, no dashboard to keep checking.</p>
              <p><strong>The Google Search Console Report</strong> shows clicks, impressions, CTR and average position from your Search Console property next to the previous period, for your top queries, countries, devices and pages, so a query slipping down the results shows up while you can still act on it.</p>
              <a href="https://webperformancereport.com/report/gsc/" rel="noopener" target="_blank" class="ui-component-button ui-component-button-normal ui-section-about__button">See the search report</a>
            </div>
            <!-- THE SOURCE: the tool behind this page's report -->
            <div class="ui-section-about__card ui-section-about__card--source">
              <h3 class="ui-section-about__title">Where the data comes from</h3>
              <a href="https://search.google.com/search-console/about?utm_source=webperfreport&utm_medium=website&utm_campaign=about" rel="noopener" target="_blank" class="ui-section-about__logo"><img alt="Google Search Console" width="200" height="92" loading="lazy" src="{{ '/' | url }}assets/img/catalog/google-search-console.png"></a>
              <p>Google Search Console is Google’s free service for site owners. It shows how Google Search sees your site: which pages are indexed, which queries they appear for and how often people click through. For most teams it is the only first-party source of organic search data.</p>
              <p>It keeps up to 16 months of search data and connects with Google Analytics 4.</p>
              <a href="https://search.google.com/search-console/about?utm_source=webperfreport&utm_medium=website&utm_campaign=about" rel="noopener" target="_blank" class="ui-component-button ui-component-button-normal ui-section-about__button">Explore Google Search Console</a>
            </div>
          </div>
        </div>
      </section>
      {% include "layouts/shared/users.njk" %}
      {% block shared_content_catalog %}
      {% endblock %}
      <section class="ui-section-title">
        <div class="ui-layout-container">
          <h2>Inside the Search Performance Report</h2><a name="Report"></a>
        </div>
      </section>
      <section class="ui-section-inside">
        <div class="ui-layout-container">
          <p class="ui-text-intro ui-section-inside__intro">Search is often how people find you for the first time, and when a query or a page drops in the results, fewer of them get there. Every report shows your clicks, impressions, CTR and position next to the previous period across the five areas below, so you can see what is gaining ground, what is dropping and where to focus next.</p>
          <ul class="ui-section-inside__cards">
            <li class="ui-section-inside__card">
              <h3 class="ui-section-inside__title">Performance summary</h3>
              <p>Clicks, impressions, click-through rate and average position, each with the change against the previous period.</p>
            </li>
            <li class="ui-section-inside__card">
              <h3 class="ui-section-inside__title">Top queries</h3>
              <p>The searches that bring people to your site, with clicks, impressions, CTR and position for each, so you can see which are gaining ground and which are dropping.</p>
            </li>
            <li class="ui-section-inside__card">
              <h3 class="ui-section-inside__title">Top countries</h3>
              <p>Where your search traffic comes from, so you can see which markets are growing in the results.</p>
            </li>
            <li class="ui-section-inside__card">
              <h3 class="ui-section-inside__title">Device category</h3>
              <p>How your search performance splits across devices, and whether one starts earning clicks differently from the rest.</p>
            </li>
            <li class="ui-section-inside__card">
              <h3 class="ui-section-inside__title">Top pages</h3>
              <p>The pages that earn the most search traffic, so you can tell which content Google is sending people to.</p>
            </li>
          </ul>
          <a href="https://webperformancereport.com/report/gsc/" rel="noopener" target="_blank" class="ui-component-button ui-component-button-normal ui-component-button-primary ui-section-inside__button">See a full search report</a>
        </div>
      </section>
      <section class="ui-section-title">
        <div class="ui-layout-container">
          <h2>Contact</h2><a name="Contact"></a>
        </div>
      </section>
      <section class="ui-section-close">
        <div class="ui-layout-container">
          <p>Get in touch: <a href="mailto: info@webperformancereport.com">info@webperformancereport.com</a></p>
		      <p><a href="https://www.producthunt.com/products/WebPerformance-Report" rel="noopener" target="_blank"><img loading="lazy" src="https://api.producthunt.com/widgets/embed-image/v1/review.svg?post_id=297274&theme=light" alt="WebPerformance Report - Web page performance test every week in your inbox.  | Product Hunt" style="width: 250px; height: 54px;" width="250" height="54"  /></a></p>
          <address>
            <strong>WebPerformance Report</strong><br>
            Reports. Decisions. Results.
            <br>
            <small>(stable version 😊)</small>
          </address>
        </div>
      </section>
    </main>
    {% block shared_content_footer %}
    {% endblock %}
  </body>
</html>
