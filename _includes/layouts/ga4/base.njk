            <img src="{{ '/' | url }}assets/img/ga4/google-analytics-ga4-hero-image.jpg?2608" width="512" height="343" fetchpriority="high" alt="Google Analytics 4 report showing an analytics summary with active users, new users, sessions and views" class="ui-image-half-right">
