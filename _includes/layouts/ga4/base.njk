            <!-- COPYWRITING -->
            <div>
              <p class="ui-section-hero--eyebrow">Reports. Decisions. Results.</p>
              <h1><span style="font-size: 2.4rem; color: #fff;">Google Analytics 4 </span> <span style="font-size: 3.10rem;">Report</span></h1>
              <p class="ui-text-intro ui-section-hero--lead">Web analytics report delivered directly to your inbox.</p>
              <p class="ui-text-intro">Traffic numbers only mean something next to last week’s. Every report sets them side by side, so a channel drying up or a page losing its audience shows up while you can still act on it. Pulled from your Google Analytics 4 property, and no dashboard to log into.</p>
              <!-- CTA -->
              <div class="ui-component-cta ui-layout-flex">
                <div class="ui-section-hero--actions">
                  <a href="#Subscribe" role="link" aria-label="Get the Report" class="ui-component-button ui-component-button-normal ui-component-button-primary">Get the Report</a>
