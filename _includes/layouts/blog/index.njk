{% extends 'layouts/blog/base.njk' %}
{% block pagemaincontent %}
  <section class="ui-section-title">
    <div class="ui-layout-container">
      <h1>Blog</h1>
    </div>
  </section>
  <section class="ui-section-blog">
    <div class="ui-layout-container">
      <div class="ui-section-blog__grid">
        {% for post in collections.post | reverse %}
          <article class="ui-component-card ui-component-card--post">
            <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            <p class="ui-text-note">
              <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
            </p>
            {% if post.data.description %}
              <p>{{ post.data.description }}</p>
            {% endif %}
            <a href="{{ post.url }}" class="ui-component-button ui-component-button-normal ui-component-button-secondary" role="link" aria-label="Read {{ post.data.title }}">Read more</a>
          </article>
        {% else %}
          <p>No posts yet.</p>
        {% endfor %}
      </div>
    </div>
  </section>
{% endblock %}
{% block shared_content_footer %}
  {% include "layouts/shared/footer.njk" %}
{% endblock %}
