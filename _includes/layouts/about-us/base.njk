<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Cookiebot cookie consent script: Banner script -->
    <script defer id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="7819dc9c-01f3-4d09-a8dc-b26fa39e69c0" data-blockingmode="auto" type="text/javascript"></script>

    <!-- META -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta name="author" content="WebPerformance Report">
    <meta name="description" content="We believe that performance is not just about speed. It's about trust, accessibility, security, and the overall quality of every digital experience...">
    <meta name="robots" content="index, follow">
    <meta property="og:title" content="About Us | WebPerformance Report">
    <meta property="og:description" content="We believe that performance is not just about speed. It's about trust, accessibility, security, and the overall quality of every digital experience...">
    <meta property="og:image" content="https://webperformancereport.com/assets/img/webperformance-report-about-us.png">
    <meta property="og:image:alt" content="About Us | WebPerformance Report">
    <meta property="og:locale" content="en_GB">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://webperformancereport.com/about-us/">

    <!-- TWITTER CARD -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@webperfreport" />
    <meta name="twitter:title" content="About US | WebPerformance Report" />
    <meta name="twitter:description" content="We believe that performance is not just about speed. It's about trust, accessibility, security, and the overall quality of every digital experience..." />
    <meta name="twitter:image" content="https://webperformancereport.com/assets/img/webperformance-report-about-us.png" />

    <!-- SPEED -->

    <!-- LINK -->
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="icon" href="{{ '/' | url }}favicon.ico">
    <link rel="apple-touch-icon" href="{{ '/' | url }}apple-touch-icon.png">

    <style>
    /* inter-regular - latin */
    @font-face {
      font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
      font-family: 'Inter';
      font-style: normal;
      font-weight: 400;
      src: url('{{ "/" | url }}fonts/inter-v12-latin-regular.woff2') format('woff2'), /* Chrome 36+, Opera 23+, Firefox 39+ */
          url('{{ "/" | url }}fonts/inter-v12-latin-regular.woff') format('woff'); /* Chrome 5+, Firefox 3.6+, IE 9+, Safari 5.1+ */
    }

    /* inter-700 - latin */
    @font-face {
      font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
      font-family: 'Inter';
      font-style: normal;
      font-weight: 700;
      src: url('{{ "/" | url }}fonts/inter-v12-latin-700.woff2') format('woff2'), /* Chrome 36+, Opera 23+, Firefox 39+ */
          url('{{ "/" | url }}fonts/inter-v12-latin-700.woff') format('woff'); /* Chrome 5+, Firefox 3.6+, IE 9+, Safari 5.1+ */
    }
    </style>

    <link rel="preload" as="style" href="{{ '/' | url }}style.css?20260830b">
    <link rel="stylesheet" href="{{ '/' | url }}style.css?20260830b">

    <!-- TITLE -->
    <title>{{ title }}</title>
  </head>
  <body class="{{ pageClass }}">
    <header role="banner" class="ui-section-header">
      <div class="ui-layout-container">
        <div class="ui-section-header__layout ui-layout-flex">
          <!-- LOGO -->
          <a href="{{ '/' | url }}" role="link" class="ui-section-header--logo">
            <img src="{{ '/' | url }}assets/img/webperformance-report-logo.png" width="100" height="100" alt="WebPerformance Report" class="">
          </a>
          <!-- HAMBURGER -->
          <input type="checkbox" id="ui-section-header--menu-id">
          <label for="ui-section-header--menu-id" class="ui-section-header--menu-icon"></label>
          <!-- MENU -->
          <nav role="navigation" class="ui-section-header--nav ui-layout-flex">
            <a href="{{ '/' | url }}#Subscribe" role="link" aria-label="Subscribe" class="ui-section-header--nav-link">Subscribe</a>
            <a href="{{ '/' | url }}#Catalog" role="link" aria-label="Catalog" class="ui-section-header--nav-link">Catalog</a>
            <a href="{{ '/' | url }}#Report" role="link" aria-label="Report" class="ui-section-header--nav-link">Report</a>
            <a href="{{ '/' | url }}plans/" role="link" aria-label="Plans" class="ui-section-header--nav-link ui-section-header--nav-link-featured">Plans</a>
            <a href="{{ '/' | url }}#Contact" role="link" aria-label="Contact" class="ui-section-header--nav-link">Contact</a>
            <a href="https://board.webperformancereport.com/" rel="noopener" target="_blank" role="link" aria-label="Your Board" class="ui-section-header--nav-board"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3h4a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-4"/><path d="M8 14l4-4-4-4"/><path d="M12 10H3"/></svg><span>Your Board</span></a>
          </nav>
        </div>
      </div>
    </header>
    <main role="main">
      <section class="ui-section-title">
        <div class="ui-layout-container">
          <h1>{{ mainTitle }}</h1>
        </div>
      </section>
      <section class="ui-section-about">
        <div class="ui-layout-container">
          {% block pagemaincontent %}
          {% endblock %}
        </div>
      </section>
    </main>
    {% block shared_content_footer %}
    {% endblock %}
  </body>
</html>